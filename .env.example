# Copy this file to .env and fill in real values. .env is gitignored - never commit it.
# This file (.env.example) IS committed, so keep it placeholders only - never paste
# real keys/URLs in here.
#
# Expo only inlines env vars prefixed with EXPO_PUBLIC_ into the app bundle at build time.
# That also means anything here ships inside the compiled app and can be extracted by
# anyone who has the app installed - fine for hackathon/dev use, but before any real
# deployment (especially the Gemini keys below) proxy these calls through a backend
# (e.g. a Supabase Edge Function) instead of calling them straight from the client.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Up to 4 Gemini API keys for automatic quota fallback (lib/claude.ts) - when
# one hits a quota error, the next is tried automatically. Only key 1 is
# required; unset slots are skipped. For real fallback benefit (not just a
# testable code path), these should be genuinely separate keys/projects, not
# copies of the same key.
EXPO_PUBLIC_GEMINI_API_KEY_1=your-gemini-api-key-1
EXPO_PUBLIC_GEMINI_API_KEY_2=your-gemini-api-key-2
EXPO_PUBLIC_GEMINI_API_KEY_3=your-gemini-api-key-3
EXPO_PUBLIC_GEMINI_API_KEY_4=your-gemini-api-key-4
